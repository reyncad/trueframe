@{
    ViewData["Title"] = "True Frame";
}

<section class="elite-hero">

    <div class="container">

        <div class="row align-items-center min-vh-100">

            <div class="col-lg-6">

                <div class="hero-mini-badge">
                    <span></span>
                    Yapay Zekâ Görsel Tespiti ve Kalite Analizi
                </div>

                <h1 class="elite-title mt-4">
                    Görsellerin gerçekliğini ve kalitesini tek ekranda analiz et.
                </h1>

                <p class="elite-subtitle mt-4">
                    True Frame, yüklenen görsellerin yapay zekâ tarafından üretilip üretilmediğini,
                    güven oranı, açıklama metni ve kalite skoru ile kullanıcıya anlaşılır şekilde sunan
                    modern bir karar destek sistemidir.
                </p>

                <div class="hero-actions mt-5">

                    <a asp-controller="Analysis" asp-action="Upload" class="btn btn-primary btn-lg rounded-4 px-5">
                        Analiz Yap
                    </a>

                    <a asp-controller="Home" asp-action="About" class="btn btn-light btn-lg rounded-4 px-5 shadow-sm">
                        Sistemi İncele
                    </a>

                </div>

                <div class="hero-stats mt-5">

                    <div>
                        <strong>Real/Fake</strong>
                        <span>AI üretim tespiti</span>
                    </div>

                    <div>
                        <strong>Quality</strong>
                        <span>Netlik, kontrast, gürültü</span>
                    </div>

                    <div>
                        <strong>Explainable</strong>
                        <span>Açıklamalı sonuç</span>
                    </div>

                </div>

            </div>

            <div class="col-lg-6 mt-5 mt-lg-0">

                <div class="elite-dashboard-card">

                    <div class="dashboard-top">
                        <div>
                            <h5>True Frame Analysis</h5>
                            <p>Demo result preview</p>
                        </div>

                        <span class="status-pill">Completed</span>
                    </div>

                    <div class="image-preview-demo">
                        <div class="scan-line"></div>
                        <span>Image Preview Area</span>
                    </div>

                    <div class="result-grid mt-4">

                        <div class="result-mini-card">
                            <p>AI Probability</p>
                            <h3>72%</h3>
                            <div class="progress">
                                <div class="progress-bar" style="width:72%"></div>
                            </div>
                        </div>

                        <div class="result-mini-card">
                            <p>Real Probability</p>
                            <h3>28%</h3>
                            <div class="progress">
                                <div class="progress-bar bg-success" style="width:28%"></div>
                            </div>
                        </div>

                    </div>

                    <div class="quality-box mt-4">

                        <div>
                            <p>Quality Score</p>
                            <h3>84/100</h3>
                        </div>

                        <div class="quality-circle">
                            84
                        </div>

                    </div>

                    <div class="explain-box mt-4">
                        Işık dağılımı, doku geçişleri ve yapısal tutarsızlıklar analiz edilerek açıklanabilir sonuç üretilir.
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="feature-section">

    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">Process</span>
            <h2 class="section-title">Sistem nasıl çalışır?</h2>
            <p class="section-desc">
                Kullanıcı teknik bilgiye ihtiyaç duymadan görsel yükler, analiz türünü seçer ve sonucu yorumlayabilir.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <h4>Görsel Yükleme</h4>
                    <p>
                        Kullanıcı JPG, PNG veya WEBP formatında görsel yükler.
                        Sistem görseli ön izleme olarak gösterir.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <h4>Analiz Seçimi</h4>
                    <p>
                        Real/Fake analizi, kalite analizi veya iki analiz aynı anda seçilebilir.
                        Seçim yapılmazsa iki analiz birlikte çalışır.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <h4>Sonuç Ekranı</h4>
                    <p>
                        AI/Real yüzdesi, güven oranı, kalite skoru ve açıklama metni tek ekranda sade biçimde gösterilir.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="user-type-section">

    <div class="container">

        <div class="row g-4 align-items-center">

            <div class="col-lg-5">

                <span class="section-label">User Types</span>

                <h2 class="section-title">
                    Misafir ve kayıtlı kullanıcı akışı
                </h2>

                <p class="section-desc">
                    Sistem hem hızlı deneme yapmak isteyen misafir kullanıcıları hem de analiz geçmişini saklamak isteyen kayıtlı kullanıcıları destekler.
                </p>

            </div>

            <div class="col-lg-7">

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="user-flow-card">
                            <h4>Misafir Kullanıcı</h4>
                            <p>Hızlı analiz yapmak isteyen kullanıcılar içindir.</p>

                            <ul>
                                <li>Sınırlı analiz hakkı</li>
                                <li>Geçmiş kayıt tutulmaz</li>
                                <li>Hızlı erişim sağlar</li>
                            </ul>

                            <a asp-controller="Auth" asp-action="Guest" class="btn btn-outline-primary rounded-4 w-100">
                                Misafir Devam Et
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="user-flow-card premium">
                            <h4>Kayıtlı Kullanıcı</h4>
                            <p>Analiz geçmişini yönetmek isteyen kullanıcılar içindir.</p>

                            <ul>
                                <li>Sınırsız analiz</li>
                                <li>Kayıtlarım ekranı</li>
                                <li>Tarihe ve türe göre filtreleme</li>
                            </ul>

                            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary rounded-4 w-100">
                                Giriş Yap
                            </a>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>