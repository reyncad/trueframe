@{
    ViewData["Title"] = T["nav.home"];
}

<section class="elite-hero">

    <div class="container">

        <div class="row align-items-center min-vh-100">

            <div class="col-lg-6">

                <div class="hero-mini-badge">
                    <span></span>
                    @T["hero.badge"]
                </div>

                <h1 class="elite-title mt-4">
                    @T["hero.title"]
                </h1>

                <p class="elite-subtitle mt-4">
                    @T["hero.subtitle"]
                </p>

                <div class="hero-actions mt-5">

                    <a asp-controller="Analysis" asp-action="Upload" class="btn btn-primary btn-lg rounded-4 px-5">
                        @T["hero.cta"]
                    </a>

                    <a asp-controller="Home" asp-action="About" class="btn btn-light btn-lg rounded-4 px-5 shadow-sm">
                        @T["hero.cta2"]
                    </a>

                </div>

                <div class="hero-stats mt-5">

                    <div>
                        <strong>@T["hero.s1.title"]</strong>
                        <span>@T["hero.s1.desc"]</span>
                    </div>

                    <div>
                        <strong>@T["hero.s2.title"]</strong>
                        <span>@T["hero.s2.desc"]</span>
                    </div>

                    <div>
                        <strong>@T["hero.s3.title"]</strong>
                        <span>@T["hero.s3.desc"]</span>
                    </div>

                </div>

            </div>

            <div class="col-lg-6 mt-5 mt-lg-0">

                <div class="elite-dashboard-card">

                    <div class="dashboard-top">
                        <div>
                            <h5>@T["hero.demo.title"]</h5>
                            <p>@T["hero.demo.sub"]</p>
                        </div>

                        <span class="status-pill">@T["hero.demo.done"]</span>
                    </div>

                    <div class="image-preview-demo">
                        <div class="scan-line"></div>
                        <span>@T["hero.demo.img"]</span>
                    </div>

                    <div class="result-grid mt-4">

                        <div class="result-mini-card">
                            <p>@T["hero.demo.ai"]</p>
                            <h3>72%</h3>
                            <div class="progress">
                                <div class="progress-bar" style="width:72%"></div>
                            </div>
                        </div>

                        <div class="result-mini-card">
                            <p>@T["hero.demo.real"]</p>
                            <h3>28%</h3>
                            <div class="progress">
                                <div class="progress-bar bg-success" style="width:28%"></div>
                            </div>
                        </div>

                    </div>

                    <div class="quality-box mt-4">

                        <div>
                            <p>@T["hero.demo.qual"]</p>
                            <h3>84/100</h3>
                        </div>

                        <div class="quality-circle">
                            84
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="feature-section">

    <div class="container">

        <div class="text-center mb-5">
            <span class="section-label">@T["proc.label"]</span>
            <h2 class="section-title">@T["proc.title"]</h2>
            <p class="section-desc">@T["proc.desc"]</p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <h4>@T["proc.s1.title"]</h4>
                    <p>@T["proc.s1.desc"]</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <h4>@T["proc.s2.title"]</h4>
                    <p>@T["proc.s2.desc"]</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <h4>@T["proc.s3.title"]</h4>
                    <p>@T["proc.s3.desc"]</p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="user-type-section">

    <div class="container">

        <div class="row g-4 align-items-center">

            <div class="col-lg-5">

                <span class="section-label">@T["user.label"]</span>

                <h2 class="section-title">
                    @T["user.title"]
                </h2>

                <p class="section-desc">
                    @T["user.desc"]
                </p>

            </div>

            <div class="col-lg-7">

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="user-flow-card">
                            <h4>@T["user.guest.title"]</h4>
                            <p>@T["user.guest.desc"]</p>

                            <ul>
                                <li>@T["user.guest.l1"]</li>
                                <li>@T["user.guest.l2"]</li>
                                <li>@T["user.guest.l3"]</li>
                            </ul>

                            <a asp-controller="Auth" asp-action="Guest" class="btn btn-outline-primary rounded-4 w-100">
                                @T["user.guest.cta"]
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="user-flow-card premium">
                            <h4>@T["user.reg.title"]</h4>
                            <p>@T["user.reg.desc"]</p>

                            <ul>
                                <li>@T["user.reg.l1"]</li>
                                <li>@T["user.reg.l2"]</li>
                                <li>@T["user.reg.l3"]</li>
                            </ul>

                            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary rounded-4 w-100">
                                @T["user.reg.cta"]
                            </a>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
