@{
    ViewData["Title"] = T["nav.about"];
}

<div class="container py-5">

    <div class="text-center mb-5">
        <span class="section-label mb-3 d-inline-block">
            @T["about.label"]
        </span>

        <h1 class="fw-bold display-5">
            @T["about.title"]
        </h1>

        <p class="text-muted mt-3">
            @T["about.desc"]
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="info-card h-100">
                <h4>1. @T["proc.s1.title"]</h4>
                <p>@T["proc.s1.desc"]</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="info-card h-100">
                <h4>2. @T["proc.s2.title"]</h4>
                <p>@T["proc.s2.desc"]</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="info-card h-100">
                <h4>3. @T["proc.s3.title"]</h4>
                <p>@T["proc.s3.desc"]</p>
            </div>
        </div>

    </div>

    <div class="row g-4 mt-4">

        <div class="col-md-6">
            <div class="info-card h-100">
                <h4>@T["up.rf"]</h4>
                <p>
                    @if (T.Lang == "tr")
                    {
                        <text>Bu analiz, görselin yapay zekâ tarafından üretilmiş olma ihtimalini yüzdesel olarak gösterir.
                        Anatomik tutarsızlık, yapay doku geçişi, ışık dağılımı ve artefakt gibi işaretler açıklama bölümünde sunulur.</text>
                    }
                    else
                    {
                        <text>This analysis shows the probability that the image was generated by AI as a percentage.
                        Signs such as anatomical inconsistency, artificial texture transitions, light distribution and artifacts are presented in the explanation section.</text>
                    }
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="info-card h-100">
                <h4>@T["up.q"]</h4>
                <p>
                    @if (T.Lang == "tr")
                    {
                        <text>Görselin netlik, kontrast, gürültü seviyesi ve kullanılabilirlik gibi teknik kalite ölçütleri değerlendirilir.
                        Sonuçlar kalite skoru ile kullanıcıya sade biçimde gösterilir.</text>
                    }
                    else
                    {
                        <text>Technical quality metrics such as sharpness, contrast, noise level and usability of the image are evaluated.
                        Results are presented clearly to the user with a quality score.</text>
                    }
                </p>
            </div>
        </div>

    </div>

    <div class="text-center mt-5 mb-4">
        <span class="section-label">@(T.Lang == "tr" ? "Ekip" : "Team")</span>
        <h2 class="section-title">@(T.Lang == "tr" ? "Projeyi geliştiren ekip" : "The team behind the project")</h2>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-md-4">
            <div class="info-card h-100 text-center">
                <div class="team-avatar mb-3">EB</div>
                <h5 class="fw-bold mb-1">Emine Balıktay</h5>
                <p class="text-muted small mb-0">@(T.Lang == "tr" ? "Frontend Geliştirici — ASP.NET Core MVC arayüzü" : "Frontend Developer — ASP.NET Core MVC UI")</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="info-card h-100 text-center">
                <div class="team-avatar mb-3">NŞ</div>
                <h5 class="fw-bold mb-1">Nisa Şahinoğlu</h5>
                <p class="text-muted small mb-0">@(T.Lang == "tr" ? "Backend Geliştirici — Kalite analizi ve Docker" : "Backend Developer — Quality analysis & Docker")</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="info-card h-100 text-center">
                <div class="team-avatar mb-3">RÇ</div>
                <h5 class="fw-bold mb-1">Reyyan Çadırcı</h5>
                <p class="text-muted small mb-0">@(T.Lang == "tr" ? "AI Model — Tespit modeli, entegrasyon ve koordinasyon" : "AI Model — Detection model, integration & coordination")</p>
            </div>
        </div>

    </div>

</div>
