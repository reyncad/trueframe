<!DOCTYPE html>
<html lang="@T.Lang" style="color-scheme:dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - True Frame</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrueFrameUI.styles.css" asp-append-version="true" />
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();
        var returnUrl         = Context.Request.Path + Context.Request.QueryString;
    }

    <nav class="navbar navbar-expand-lg custom-navbar shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold" style="color:var(--text-1)!important" asp-controller="Home" asp-action="Index">
                True Frame
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active-link" : "")"
                           asp-controller="Home" asp-action="Index">
                            @T["nav.home"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Analysis" && currentAction == "Upload" ? "active-link" : "")"
                           asp-controller="Analysis" asp-action="Upload">
                            @T["nav.analyze"]
                        </a>
                    </li>

                    @if (Context.Session.GetString("UserType") == "Registered")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Analysis" && currentAction == "History" ? "active-link" : "")"
                               asp-controller="Analysis" asp-action="History">
                                @T["nav.history"]
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active-link" : "")"
                           asp-controller="Home" asp-action="About">
                            @T["nav.about"]
                        </a>
                    </li>

                    @* ── Dil seçici ── *@
                    <li class="nav-item ms-lg-2">
                        <div class="lang-switcher d-flex align-items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 style="opacity:.6;vertical-align:middle">
                                <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                            <a href="/Language/Switch?lang=tr&returnUrl=@Uri.EscapeDataString(returnUrl)"
                               class="lang-btn @(T.Lang == "tr" ? "lang-active" : "")">TR</a>
                            <span style="opacity:.3;font-size:.75rem">|</span>
                            <a href="/Language/Switch?lang=en&returnUrl=@Uri.EscapeDataString(returnUrl)"
                               class="lang-btn @(T.Lang == "en" ? "lang-active" : "")">EN</a>
                        </div>
                    </li>

                    @if (Context.Session.GetString("UserType") == "Registered")
                    {
                        <li class="nav-item ms-lg-3">
                            <span class="nav-user-pill">
                                @Context.Session.GetString("UserEmail")
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-outline-primary rounded-4 px-3"
                               asp-controller="Auth" asp-action="Logout">
                                @T["nav.logout"]
                            </a>
                        </li>
                    }
                    else if (Context.Session.GetString("UserType") == "Guest")
                    {
                        <li class="nav-item ms-lg-3">
                            <span class="nav-guest-pill">@T["nav.guest"]</span>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary rounded-4 px-3"
                               asp-controller="Auth" asp-action="Login">
                                @T["nav.login"]
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-primary rounded-4 px-3"
                               asp-controller="Auth" asp-action="Login">
                                @T["nav.login"]
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="custom-footer mt-5">
        <div class="container py-4">
            <div class="row align-items-center">

                <div class="col-md-6">
                    <h5 class="fw-bold mb-1" style="color:var(--text-1)">True Frame</h5>
                    <p class="mb-0" style="color:var(--text-2);font-size:.9rem">
                        @T["footer.desc"]
                    </p>
                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <p class="mb-1" style="color:var(--text-3);font-size:.85rem">
                        @T["footer.uni"]
                    </p>
                    <p class="mb-0" style="color:var(--text-3);font-size:.85rem">
                        Emine Balıktay &bull; Nisa Şahinoğlu &bull; Reyyan Çadırcı
                    </p>
                </div>

            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
