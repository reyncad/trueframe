@model TrueFrameUI.Models.AnalysisViewModel
@*
    PDF rapor şablonu — Result ve Details sayfalarında ortak kullanılır.

    KÖK NEDEN DÜZELTMESİ:
    Eski jsPDF doc.text() yaklaşımı 'helvetica' yerleşik fontu kullanıyordu;
    bu font Türkçe karakterleri (ğ, ş, İ, ı, ö, ü, ç) desteklemediği için PDF
    bozuk metinle üretiliyordu. Ayrıca görsel önizleme ve metriklerin çoğu
    (pozlama, renk, geometri, EXIF, profil kontrolleri) PDF'e hiç yazılmıyordu.

    Yeni yaklaşım: Bu gizli DOM şablonu html2pdf.js (html2canvas + jsPDF) ile
    rasterleştirilir → tüm Unicode metin doğru görünür, tüm alanlar dahildir,
    sayfalama .pdf-block { page-break-inside: avoid } ile kontrol edilir,
    sayfa numaraları üretim sonrası jsPDF ile basılır.
*@

<div id="pdfReportWrapper" style="position:absolute; left:0; top:0; opacity:0; pointer-events:none; overflow:hidden; width:720px; height:0;">
    <div id="pdfReport" style="width:720px; background:#ffffff; color:#0f172a; font-family:'Segoe UI', Arial, sans-serif; padding:28px 32px; font-size:12px; line-height:1.5;">

        @* ── Başlık ── *@
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid #2563eb; padding-bottom:12px; margin-bottom:18px;">
            <div>
                <div style="font-size:20px; font-weight:800; color:#2563eb;">TrueFrame</div>
                <div style="font-size:13px; color:#475569;">AI Görsel Doğrulama &amp; Kalite Analiz Raporu</div>
            </div>
            <div style="text-align:right; font-size:11px; color:#64748b;">
                @if (!string.IsNullOrEmpty(Model.OriginalName))
                {
                    <div><strong>Dosya:</strong> @Model.OriginalName</div>
                }
                <div><strong>Rapor Tarihi:</strong> @DateTime.Now.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))</div>
                @if (!string.IsNullOrEmpty(Model.CreatedAt))
                {
                    <div><strong>Analiz Tarihi:</strong> @Model.CreatedAt</div>
                }
            </div>
        </div>

        @* ── Görsel önizleme + teknik bilgi ── *@
        <div class="pdf-block" style="display:flex; gap:20px; margin-bottom:18px;">
            @if (!string.IsNullOrEmpty(Model.ImagePath) && Model.ImagePath.StartsWith("data:"))
            {
                <img src="@Model.ImagePath" style="max-width:260px; max-height:200px; object-fit:contain; border:1px solid #e2e8f0; border-radius:8px;" />
            }
            <table style="flex:1; border-collapse:collapse; font-size:11.5px;">
                @if (Model.ImgWidth > 0)
                {
                    <tr><td style="color:#64748b; padding:3px 8px 3px 0;">Çözünürlük</td><td style="font-weight:600;">@Model.ImgWidth × @Model.ImgHeight px (@Model.Megapixels.ToString("F2") MP)</td></tr>
                }
                @if (!string.IsNullOrEmpty(Model.ImgFormat))
                {
                    <tr><td style="color:#64748b; padding:3px 8px 3px 0;">Format / Renk Modu</td><td style="font-weight:600;">@Model.ImgFormat / @Model.ColorMode</td></tr>
                }
                @if (Model.Dpi.HasValue)
                {
                    <tr><td style="color:#64748b; padding:3px 8px 3px 0;">DPI</td><td style="font-weight:600;">@Model.Dpi.Value.ToString("F0")</td></tr>
                }
                @if (!string.IsNullOrEmpty(Model.ExifDatetime))
                {
                    <tr><td style="color:#64748b; padding:3px 8px 3px 0;">Çekim Tarihi</td><td style="font-weight:600;">@Model.ExifDatetime</td></tr>
                }
            </table>
        </div>

        @* ── Real/Fake ── *@
        @if (Model.RealFakeSelected)
        {
            <div class="pdf-block" style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:14px 16px; margin-bottom:14px;">
                <div style="font-size:14px; font-weight:700; color:#1e40af; margin-bottom:8px;">Real / Fake Analizi</div>
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                    <tr>
                        <td style="padding:3px 0; color:#64748b;">Tespit Sonucu</td>
                        <td style="font-weight:700;">@Model.Label</td>
                        <td style="padding:3px 0; color:#64748b;">Güven</td>
                        <td style="font-weight:700;">%@Model.ConfidenceScore.ToString("F1")</td>
                    </tr>
                    <tr>
                        <td style="padding:3px 0; color:#64748b;">AI Olasılığı</td>
                        <td style="font-weight:700; color:#dc2626;">%@Model.AiProbability.ToString("F1")</td>
                        <td style="padding:3px 0; color:#64748b;">Gerçek Olasılığı</td>
                        <td style="font-weight:700; color:#16a34a;">%@Model.RealProbability.ToString("F1")</td>
                    </tr>
                    @if (Model.ManipScore > 0 || Model.IsManipulated)
                    {
                        <tr>
                            <td style="padding:3px 0; color:#64748b;">Manipülasyon</td>
                            <td style="font-weight:700; color:@(Model.IsManipulated ? "#dc2626" : "#16a34a");">
                                @(Model.IsManipulated ? "TESPİT EDİLDİ" : "Tespit edilmedi")
                            </td>
                            <td style="padding:3px 0; color:#64748b;">Manipülasyon Skoru</td>
                            <td style="font-weight:700;">%@Model.ManipScore.ToString("F1")</td>
                        </tr>
                    }
                </table>
            </div>
        }

        @* ── Kalite ── *@
        @if (Model.QualitySelected && Model.QualityScore > 0)
        {
            <div class="pdf-block" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:14px 16px; margin-bottom:14px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <div style="font-size:14px; font-weight:700; color:#166534;">Görsel Kalite Analizi</div>
                    <div style="font-size:22px; font-weight:800; color:#166534;">@Model.QualityScore.ToString("F0")<span style="font-size:12px; color:#64748b;">/100</span></div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ProfileLabel))
                {
                    <div style="font-size:11px; color:#475569; margin-bottom:6px;">Profil: <strong>@Model.ProfileLabel</strong> — @Model.ProfilePass/@Model.ProfileTotal kontrol geçildi</div>
                }
                @if (!string.IsNullOrEmpty(Model.Verdict))
                {
                    <div style="font-size:11.5px; color:#334155; font-style:italic; border-left:3px solid #86efac; padding-left:10px; margin-bottom:10px;">@Model.Verdict</div>
                }

                @* 6D grid *@
                <table style="width:100%; border-collapse:collapse; text-align:center; font-size:11px;">
                    <tr>
                        @foreach (var (lbl, val) in new[] {
                            ("Keskinlik", Model.Sharpness), ("Gürültü", Model.Noise), ("Pozlama", Model.Exposure),
                            ("Renk", Model.Color), ("Estetik", Model.Aesthetics), ("Teknik", Model.Technical) })
                        {
                            <td style="padding:6px; border:1px solid #d1fae5; background:#ffffff;">
                                <div style="font-size:16px; font-weight:800; color:@(val >= 75 ? "#16a34a" : val >= 50 ? "#ca8a04" : "#dc2626");">@val.ToString("F0")</div>
                                <div style="color:#64748b;">@lbl</div>
                            </td>
                        }
                    </tr>
                </table>
            </div>

            @* Pozlama *@
            @if (!string.IsNullOrEmpty(Model.ExposureLabel))
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">Pozlama Analizi</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Pozlama</td><td style="font-weight:600;">@Model.ExposureLabel</td>
                            <td style="color:#64748b;">Highlight Kırpılma</td><td style="font-weight:600;">%@Model.HighlightClip.ToString("F1")</td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Shadow Kırpılma</td><td style="font-weight:600;">%@Model.ShadowClip.ToString("F1")</td>
                            <td style="color:#64748b;">Dinamik Aralık</td><td style="font-weight:600;">@Model.DynamicRange.ToString("F1")/100</td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Ort. Parlaklık</td><td style="font-weight:600;">@Model.AvgBrightness.ToString("F0")/255</td>
                            <td style="color:#64748b;">RMS Kontrast</td><td style="font-weight:600;">@(Model.ContrastRms.HasValue ? Model.ContrastRms.Value.ToString("F1") : "—")</td>
                        </tr>
                    </table>
                </div>
            }

            @* Renk & Gürültü *@
            @if (!string.IsNullOrEmpty(Model.ColorCast))
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">Renk &amp; Gürültü</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Renk Cast</td><td style="font-weight:600;">@Model.ColorCast</td>
                            <td style="color:#64748b;">Renk Sıcaklığı</td>
                            <td style="font-weight:600;">
                                @(Model.ColorTemperature.HasValue ? $"{Model.ColorTemperature.Value:F0}K" : "—")
                                @(string.IsNullOrEmpty(Model.ColorTemperatureLabel) ? "" : $" ({Model.ColorTemperatureLabel})")
                            </td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Doygunluk</td><td style="font-weight:600;">@(Model.Saturation.HasValue ? $"%{Model.Saturation.Value:F1}" : "—")</td>
                            <td style="color:#64748b;">Kroma Gürültüsü</td><td style="font-weight:600;">@(string.IsNullOrEmpty(Model.ColorNoiseSeverity) ? (Model.ColorNoise ?? "—") : Model.ColorNoiseSeverity)</td>
                        </tr>
                        @if (Model.LumaNoise.HasValue || Model.ChromaNoise.HasValue)
                        {
                            <tr>
                                <td style="color:#64748b; padding:2px 0;">Luma / Kroma Gürültü</td>
                                <td style="font-weight:600;">@(Model.LumaNoise?.ToString("F2") ?? "—") / @(Model.ChromaNoise?.ToString("F2") ?? "—")</td>
                                <td style="color:#64748b;" colspan="2">@Model.ColorNoiseDescription</td>
                            </tr>
                        }
                    </table>
                </div>
            }

            @* Geometri & Blur *@
            @if (!string.IsNullOrEmpty(Model.BlurType))
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">Geometri &amp; Blur Analizi</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Blur Tipi</td><td style="font-weight:600;">@Model.BlurLabel</td>
                            <td style="color:#64748b;">Horizon Eğikliği</td>
                            <td style="font-weight:600;">@(Model.TiltAngle.HasValue ? $"{Model.TiltAngle.Value:+0.0;-0.0}° ({Model.TiltLabel})" : "N/A")</td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Moire Pattern</td><td style="font-weight:600;">@Model.MoireLabel (skor: @Model.MoireScore.ToString("F0")/100)</td>
                            <td colspan="2"></td>
                        </tr>
                    </table>
                </div>
            }

            @* EXIF *@
            @if (!string.IsNullOrEmpty(Model.ExifCamera) || Model.ExifIso.HasValue || !string.IsNullOrEmpty(Model.ExifAperture))
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">EXIF Verisi</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Kamera</td><td style="font-weight:600;">@(Model.ExifCamera ?? "—")</td>
                            <td style="color:#64748b;">Lens</td><td style="font-weight:600;">@(Model.ExifLens ?? "—")</td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">ISO</td><td style="font-weight:600;">@(Model.ExifIso?.ToString() ?? "—")</td>
                            <td style="color:#64748b;">Diyafram</td><td style="font-weight:600;">@(Model.ExifAperture ?? "—")</td>
                        </tr>
                        <tr>
                            <td style="color:#64748b; padding:2px 0;">Enstantane</td><td style="font-weight:600;">@(Model.ExifShutter ?? "—")</td>
                            <td style="color:#64748b;">Odak Uzunluğu</td><td style="font-weight:600;">@(Model.ExifFocalLength ?? "—")</td>
                        </tr>
                    </table>
                </div>
            }

            @* IQA metrik tablosu *@
            @if (Model.IqaMetrics.Count > 0)
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">IQA Metrik Skorları</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr style="background:#f1f5f9;">
                            <th style="text-align:left; padding:4px 8px;">Metrik</th>
                            <th style="text-align:left; padding:4px 8px;">Skor</th>
                            <th style="text-align:left; padding:4px 8px;">Kalite</th>
                            <th style="text-align:left; padding:4px 8px;">Yön</th>
                        </tr>
                        @foreach (var m in Model.IqaMetrics)
                        {
                            string ql = "—", qc = "#64748b";
                            if (!string.IsNullOrEmpty(m.Error)) { ql = "Hata"; qc = "#dc2626"; }
                            else if (m.Score.HasValue)
                            {
                                bool good = m.Direction == "higher" ? m.Score.Value >= m.GoodMin : m.Score.Value <= m.GoodMax;
                                ql = good ? "İyi" : "Zayıf";
                                qc = good ? "#16a34a" : "#ca8a04";
                            }
                            <tr>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; font-weight:600;">@m.Label</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9;">@(m.Score.HasValue ? m.Score.Value.ToString("F4") : "—")</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; color:@qc; font-weight:600;">@ql</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; color:#94a3b8;">@(m.Direction == "lower" ? "▼ düşük iyi" : "▲ yüksek iyi")</td>
                            </tr>
                        }
                    </table>
                </div>
            }

            @* Profil kontrol listesi *@
            @if (Model.Checks.Count > 0)
            {
                <div class="pdf-block" style="margin-bottom:12px;">
                    <div style="font-size:13px; font-weight:700; border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:6px;">@(string.IsNullOrEmpty(Model.ProfileLabel) ? "Profil" : Model.ProfileLabel) Kontrol Listesi</div>
                    <table style="width:100%; border-collapse:collapse; font-size:11.5px;">
                        <tr style="background:#f1f5f9;">
                            <th style="text-align:left; padding:4px 8px;"></th>
                            <th style="text-align:left; padding:4px 8px;">Kontrol</th>
                            <th style="text-align:left; padding:4px 8px;">Değer</th>
                            <th style="text-align:left; padding:4px 8px;">Gerekli</th>
                        </tr>
                        @foreach (var c in Model.Checks)
                        {
                            var icon  = c.Passed == true ? "✓" : c.Passed == false ? "✗" : "—";
                            var color = c.Passed == true ? "#16a34a" : c.Passed == false ? "#dc2626" : "#94a3b8";
                            <tr>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; color:@color; font-weight:700;">@icon</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9;">@c.Name</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; font-weight:600;">@c.Value</td>
                                <td style="padding:3px 8px; border-bottom:1px solid #f1f5f9; color:#64748b;">@c.Needed</td>
                            </tr>
                        }
                    </table>
                </div>
            }
        }
        else if (Model.QualitySelected)
        {
            <div class="pdf-block" style="color:#64748b; font-size:11.5px; margin-bottom:12px;">Kalite analizi verisi bulunamadı.</div>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    async function exportTrueFramePdf(btnId) {
        const btn = document.getElementById(btnId || 'pdfBtn');
        if (btn) { btn.disabled = true; btn.textContent = 'PDF hazırlanıyor...'; }

        const source = document.getElementById('pdfReport');

        // Wrapper'daki visibility sorununu bypass etmek için
        // içeriği doğrudan body'e clone'la, z-index:-9999 ile gizle.
        const clone = source.cloneNode(true);
        clone.style.cssText = [
            'position:fixed', 'top:0', 'left:0',
            'width:720px', 'background:#ffffff', 'color:#0f172a',
            'z-index:-9999', 'pointer-events:none', 'box-sizing:border-box'
        ].join(';');
        document.body.appendChild(clone);

        // Tarayıcının layout'u hesaplaması için bekle
        await new Promise(resolve => setTimeout(resolve, 350));

        const opt = {
            margin:      [10, 10, 14, 10],
            image:       { type: 'jpeg', quality: 0.92 },
            html2canvas: {
                scale: 1.5, useCORS: true, allowTaint: true,
                backgroundColor: '#ffffff', logging: false
            },
            jsPDF:       { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak:   { mode: ['css', 'legacy'], avoid: ['.pdf-block', 'tr'] }
        };

        try {
            await html2pdf().set(opt).from(clone).toPdf().get('pdf').then(pdf => {
                const total = pdf.internal.getNumberOfPages();
                for (let i = 1; i <= total; i++) {
                    pdf.setPage(i);
                    pdf.setFontSize(8);
                    pdf.setTextColor(130, 140, 160);
                    pdf.text('TrueFrame - AI Image Verification', 10, 292);
                    pdf.text('Sayfa ' + i + ' / ' + total, 200, 292, { align: 'right' });
                }
            }).save('trueframe-rapor-@(DateTime.Now.ToString("yyyyMMdd-HHmm")).pdf');
        } catch (e) {
            console.error('PDF üretim hatası:', e);
            alert('PDF üretilirken bir hata oluştu. Lütfen tekrar deneyiniz.');
        } finally {
            document.body.removeChild(clone);
            if (btn) { btn.disabled = false; btn.textContent = 'PDF İndir'; }
        }
    }
</script>
