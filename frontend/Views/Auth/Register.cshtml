@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-page">

    <div class="auth-card shadow-lg rounded-5 p-5">

        <div class="text-center mb-4">
            <span class="tf-badge">
                True Frame
            </span>
        </div>

        <h2 class="fw-bold text-center mb-2">
            Hesap Oluştur
        </h2>

        <p class="text-muted text-center mb-4">
            Sınırsız analiz yapmak ve geçmiş analiz kayıtlarına erişmek için kayıt ol.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-4">@ViewBag.Error</div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input type="text"
                       name="fullName"
                       class="form-control form-control-lg rounded-4"
                       placeholder="Adınızı ve soyadınızı giriniz"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text"
                       name="username"
                       class="form-control form-control-lg rounded-4"
                       placeholder="Kullanıcı adınızı giriniz"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <input type="password"
                       name="password"
                       class="form-control form-control-lg rounded-4"
                       placeholder="Şifrenizi oluşturunuz"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-4">
                Kayıt Ol
            </button>

        </form>

        <div class="text-center mt-4">
            <p class="text-muted mb-1">
                Zaten hesabın var mı?
            </p>

            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-bold">
                Giriş yap
            </a>
        </div>

        <hr class="my-4" />

        <div class="text-center">
            <a asp-controller="Auth" asp-action="Guest" class="text-decoration-none text-muted">
                Misafir olarak devam et
            </a>
        </div>

    </div>

</div>