@{
    ViewData["Title"] = T["reg.title"];
}

<div class="auth-page">

    <div class="auth-card shadow-lg rounded-5 p-5">

        <div class="text-center mb-4">
            <span class="tf-badge">
                True Frame
            </span>
        </div>

        <h2 class="fw-bold text-center mb-2">
            @T["reg.title"]
        </h2>

        <p class="text-muted text-center mb-4">
            @T["reg.sub"]
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-4">@ViewBag.Error</div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">@T["reg.name"]</label>
                <input type="text"
                       name="fullName"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["reg.name"]"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">@T["reg.user"]</label>
                <input type="text"
                       name="username"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["reg.user"]"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">@T["reg.pass"]</label>
                <input type="password"
                       name="password"
                       id="password"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["reg.pass"]"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">@T["reg.confirm"]</label>
                <input type="password"
                       name="confirmPassword"
                       id="confirmPassword"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["reg.confirm"]"
                       required />
                <div class="form-text text-danger d-none" id="passwordMismatch">
                    @T["reg.mismatch"]
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-4">
                @T["reg.btn"]
            </button>

        </form>

        <div class="text-center mt-4">
            <p class="text-muted mb-1">
                @T["reg.hasacc"]
            </p>

            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-bold">
                @T["reg.tologin"]
            </a>
        </div>

        <hr class="my-4" />

        <div class="text-center">
            <a asp-controller="Auth" asp-action="Guest" class="text-decoration-none text-muted">
                @T["reg.guest"]
            </a>
        </div>

    </div>

</div>

<script>
    document.querySelector('form').addEventListener('submit', function (e) {
        const pw = document.getElementById('password').value;
        const cpw = document.getElementById('confirmPassword').value;
        const msg = document.getElementById('passwordMismatch');
        if (pw !== cpw) {
            e.preventDefault();
            msg.classList.remove('d-none');
            document.getElementById('confirmPassword').classList.add('is-invalid');
        }
    });
    document.getElementById('confirmPassword').addEventListener('input', function () {
        document.getElementById('passwordMismatch').classList.add('d-none');
        this.classList.remove('is-invalid');
    });
</script>
