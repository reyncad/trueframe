@{
    ViewData["Title"] = T["login.title"];
}

<div class="auth-page">

    <div class="auth-card shadow-lg rounded-5 p-5">

        <div class="text-center mb-3">
            <img src="~/images/logo.png" alt="True Frame" style="height:88px;width:88px;object-fit:contain;" />
        </div>

        <h2 class="fw-bold text-center mb-2">
            @T["login.title"]
        </h2>

        <p class="text-muted text-center mb-4">
            @T["login.sub"]
        </p>

        @if (TempData["AccessError"] != null)
        {
            <div class="alert alert-warning rounded-4">@TempData["AccessError"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-4">@ViewBag.Error</div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">@T["login.user"]</label>
                <input type="text"
                       name="username"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["login.user"]"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">@T["login.pass"]</label>
                <input type="password"
                       name="password"
                       class="form-control form-control-lg rounded-4"
                       placeholder="@T["login.pass"]"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg rounded-4">
                @T["login.btn"]
            </button>

        </form>

        <div class="text-center mt-4">
            <p class="text-muted mb-1">
                @T["login.noacc"]
            </p>

            <a asp-controller="Auth" asp-action="Register" class="text-decoration-none fw-bold">
                @T["login.toreg"]
            </a>
        </div>

        <hr class="my-4" />

        <div class="text-center">
            <a asp-controller="Auth" asp-action="Guest" class="text-decoration-none text-muted">
                @T["login.guest"]
            </a>
        </div>

    </div>

</div>
