@{
    ViewData["Title"] = T["nav.analyze"];
}

<section class="upload-page">

    <div class="container py-5">

        <div class="text-center mb-5">
            <span class="section-label">@T["up.label"]</span>

            <h1 class="section-title">
                @T["up.title"]
            </h1>

            <p class="section-desc">
                @T["up.desc"]
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-4 mb-4">
                @ViewBag.Error
            </div>
        }

        <div class="row g-4 align-items-start">

            <div class="col-lg-7">

                <div class="upload-card">

                    @if (Context.Session.GetString("UserType") != null)
                    {
                        <div class="user-status-box mb-4">

                            @if (Context.Session.GetString("UserType") == "Guest")
                            {
                                <div>
                                    <strong>@T["up.guest.title"]</strong>
                                    <p>
                                        @T["up.guest.desc"]
                                        @Context.Session.GetString("GuestLimit")
                                    </p>
                                </div>

                                <span class="user-pill guest">
                                    Guest
                                </span>
                            }
                            else
                            {
                                <div>
                                    <strong>@T["up.reg.title"]</strong>
                                    <p>@T["up.reg.desc"]</p>
                                </div>

                                <span class="user-pill registered">
                                    Registered
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="user-status-box mb-4">

                            <div>
                                <strong>@T["up.no.title"]</strong>
                                <p>@T["up.no.desc"]</p>
                            </div>

                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn btn-outline-primary rounded-4">
                                @T["up.login"]
                            </a>

                        </div>
                    }

                    <form asp-controller="Analysis"
                          asp-action="Result"
                          method="post"
                          enctype="multipart/form-data"
                          onsubmit="return validateAndShowLoading()">

                        <label class="upload-drop-area" for="imageFile" style="position: relative; overflow: hidden;">
                        <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp" onchange="previewImage(event)" hidden />

                        <div id="uploadPlaceholder">
                            <div class="upload-icon">+</div>
                            <h4>@T["up.drop"]</h4>
                            <p>@T["up.formats"]</p>
                            <small>@T["up.maxsize"]</small>
                        </div>

                        <div class="preview-wrapper" id="previewWrapper" style="display:none; width: 100%; height: 100%;">
                            <div class="preview-header mb-2">
                                <strong>@T["up.preview"]</strong> <span id="fileName">image</span>
                            </div>
                            <img id="preview" src="" class="preview-image" style="max-width: 100%; max-height: 300px; object-fit: contain; border-radius: 8px;" />
                        </div>
                        </label>

                        <div class="preview-wrapper mt-4"
                             id="previewWrapper"
                             style="display:none;">

                            <div class="preview-header">

                                <strong>@T["up.preview"]</strong>

                                <span id="fileName">
                                    image
                                </span>

                            </div>

                            <img id="preview"
                                 src=""
                                 class="preview-image" />

                        </div>

                        <div class="analysis-options mt-4">

                            <h5>@T["up.type"]</h5>
                            <p>@T["up.type.desc"]</p>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="analysis-option">
                                        <input type="checkbox" name="realFakeSelected" value="true" />
                                        <div>
                                            <strong>@T["up.rf"]</strong>
                                            <span>@T["up.rf.desc"]</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label class="analysis-option">
                                        <input type="checkbox" name="qualitySelected" value="true" />
                                        <div>
                                            <strong>@T["up.q"]</strong>
                                            <span>@T["up.q.desc"]</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="default-info mt-3">
                                @T["up.default"]
                            </div>

                        </div>

                        <div class="analysis-options mt-3" id="profileSection">

                            <h5>@T["up.profile"]</h5>
                            <p>@T["up.profile.desc"]</p>

                            <div class="row g-2">
                                <div class="col-6 col-md-4">
                                    <label class="profile-option">
                                        <input type="radio" name="profile" value="none" checked />
                                        <div>
                                            <strong>🔬 @(T.Lang == "tr" ? "Genel Analiz" : "General")</strong>
                                            <span>@(T.Lang == "tr" ? "Standart değerlendirme" : "Standard evaluation")</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="profile-option">
                                        <input type="radio" name="profile" value="social" />
                                        <div>
                                            <strong>📱 @(T.Lang == "tr" ? "Sosyal Medya" : "Social Media")</strong>
                                            <span>Instagram, Twitter @(T.Lang == "tr" ? "vb." : "etc.")</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="profile-option">
                                        <input type="radio" name="profile" value="web" />
                                        <div>
                                            <strong>🌐 Web / Blog</strong>
                                            <span>@(T.Lang == "tr" ? "Web sitesi görselleri" : "Website images")</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="profile-option">
                                        <input type="radio" name="profile" value="print" />
                                        <div>
                                            <strong>🖨️ @(T.Lang == "tr" ? "Baskı (300 DPI)" : "Print (300 DPI)")</strong>
                                            <span>@(T.Lang == "tr" ? "A4 baskı kalitesi" : "A4 print quality")</span>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="profile-option">
                                        <input type="radio" name="profile" value="news" />
                                        <div>
                                            <strong>📰 @(T.Lang == "tr" ? "Haber Ajansı" : "News Agency")</strong>
                                            <span>@(T.Lang == "tr" ? "Gazetecilik standartları" : "Journalism standards")</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg rounded-4 w-100 mt-4">

                            @T["up.btn"]

                        </button>

                    </form>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="side-info-card">

                    <h4>@T["up.side.title"]</h4>

                    <ul>
                        <li>@T["up.side.l1"]</li>
                        <li>@T["up.side.l2"]</li>
                        <li>@T["up.side.l3"]</li>
                        <li>@T["up.side.l4"]</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>
<div id="customToast" class="custom-toast"></div>
<div id="loadingOverlay"
     class="loading-overlay"
     style="display:none;">

    <div class="loading-card">

        <div class="spinner-border text-primary mb-3"
             role="status">
        </div>

        <h4>@T["up.loading"]</h4>

        <p>@T["up.loading2"]</p>

        <div class="progress mt-3">

            <div class="progress-bar
                        progress-bar-striped
                        progress-bar-animated"
                 style="width:100%">
            </div>

        </div>

    </div>

</div>

<script>
    const dropArea = document.querySelector('.upload-drop-area');
    const fileInput = document.getElementById('imageFile');

    dropArea.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropArea.classList.add('drag-active');
    });

    dropArea.addEventListener('dragleave', function () {
        dropArea.classList.remove('drag-active');
    });

    dropArea.addEventListener('drop', function (e) {
        e.preventDefault();
        dropArea.classList.remove('drag-active');

        const files = e.dataTransfer.files;

        if (files.length > 0) {
            fileInput.files = files;
            previewSelectedFile(files[0]);
            showToast("@(T.Lang == "tr" ? "Görsel başarıyla seçildi." : "Image selected successfully.")", "success");
        }
    });

    function previewImage(event) {
        const input = event.target;
        const wrapper = document.getElementById('previewWrapper');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('preview');
        const fileNameSpan = document.getElementById('fileName');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function(e) {
                preview.src = e.target.result;
                fileNameSpan.textContent = input.files[0].name;
                
                // Yükleme ikonlarını gizle, görseli göster
                placeholder.style.display = 'none';
                wrapper.style.display = 'block'; 
            }

            reader.readAsDataURL(input.files[0]);
        } else {
            placeholder.style.display = 'block';
            wrapper.style.display = 'none';
        }
    }


    function previewSelectedFile(file) {
        const preview = document.getElementById('preview');
        const wrapper = document.getElementById('previewWrapper');
        const fileName = document.getElementById('fileName');

        preview.src = URL.createObjectURL(file);
        fileName.innerText = file.name;
        wrapper.style.display = 'block';
    }

    function validateAndShowLoading() {
        if (!fileInput.files || fileInput.files.length === 0) {
            showToast("@(T.Lang == "tr" ? "Lütfen analiz için bir görsel seçiniz." : "Please select an image to analyze.")", "error");
            return false;
        }

        document.getElementById('loadingOverlay').style.display = 'flex';
        return true;
    }

    function showToast(message, type) {
        const toast = document.getElementById('customToast');

        toast.innerText = message;
        toast.className = 'custom-toast show ' + type;

        setTimeout(function () {
            toast.className = 'custom-toast';
        }, 3000);
    }

    // ── Profil seçim görsel geri bildirimi ────────────────────
    (function () {
        const defaultRadio = document.querySelector('.profile-option input[type="radio"]:checked');
        if (defaultRadio) {
            defaultRadio.closest('.profile-option').classList.add('selected');
        }

        document.querySelectorAll('.profile-option input[type="radio"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.profile-option').forEach(function (p) {
                    p.classList.remove('selected');
                });
                this.closest('.profile-option').classList.add('selected');
            });
        });

        const realFakeCb     = document.querySelector('input[name="realFakeSelected"]');
        const qualityCb      = document.querySelector('input[name="qualitySelected"]');
        const profileSection = document.getElementById('profileSection');

        function updateProfileVisibility() {
            const onlyRealFake = realFakeCb.checked && !qualityCb.checked;
            profileSection.style.display = onlyRealFake ? 'none' : '';
        }

        document.querySelectorAll('.analysis-option input[type="checkbox"]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                this.closest('.analysis-option').classList.toggle('selected', this.checked);
                updateProfileVisibility();
            });
        });
    })();
</script>
