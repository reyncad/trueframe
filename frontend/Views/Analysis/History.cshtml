@model TrueFrameUI.Models.HistoryViewModel
@{
    ViewData["Title"] = T["hist.label"];
}

<section class="history-page">
    <div class="container py-5">

        <div class="history-header mb-5">
            <div>
                <span class="section-label">@T["hist.label"]</span>
                <h1 class="section-title">@T["hist.title"]</h1>
                <p class="section-desc text-start ms-0">
                    @T["hist.desc"]
                </p>
            </div>
            <a asp-controller="Analysis" asp-action="Upload" class="btn btn-primary rounded-4">
                @T["hist.new"]
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger rounded-4 mb-4">@Model.Error</div>
        }

        @if (!string.IsNullOrEmpty(Model.Warning))
        {
            <div class="alert alert-warning rounded-4 mb-4">@Model.Warning</div>
        }

        @if (TempData["AccessError"] != null)
        {
            <div class="alert alert-warning rounded-4 mb-4">@TempData["AccessError"]</div>
        }

        <form method="get" asp-controller="Analysis" asp-action="History" class="history-filter-card mb-4 p-3 rounded-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-2 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.result"]</label>
                    <select name="result" class="form-select form-select-sm rounded-3">
                        @{
                            var resultOpts = T.Lang == "tr"
                                ? new (string Val, string Lbl)[] {
                                    ("", "Tümü"), ("ai", "Yapay (AI)"), ("real", "Gerçek"),
                                    ("manip", "Manipüle"), ("uncertain", "Belirsiz") }
                                : new (string Val, string Lbl)[] {
                                    ("", "All"), ("ai", "AI"), ("real", "Real"),
                                    ("manip", "Manipulated"), ("uncertain", "Uncertain") };
                        }
                        @foreach (var o in resultOpts)
                        {
                            if (Model.FilterResult == o.Val || (string.IsNullOrEmpty(Model.FilterResult) && o.Val == ""))
                            {
                                <option value="@o.Val" selected>@o.Lbl</option>
                            }
                            else
                            {
                                <option value="@o.Val">@o.Lbl</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.score"]</label>
                    <div class="d-flex gap-1">
                        <input type="number" name="minScore" min="0" max="100" placeholder="Min"
                               value="@Model.FilterMinScore?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm rounded-3" />
                        <input type="number" name="maxScore" min="0" max="100" placeholder="Max"
                               value="@Model.FilterMaxScore?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm rounded-3" />
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.start"]</label>
                    <input type="date" name="dateFrom" value="@Model.FilterDateFrom" class="form-control form-control-sm rounded-3" />
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.end"]</label>
                    <input type="date" name="dateTo" value="@Model.FilterDateTo" class="form-control form-control-sm rounded-3" />
                </div>
                <div class="col-md-1 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.profile"]</label>
                    <select name="profile" class="form-select form-select-sm rounded-3">
                        @{
                            var profOpts = T.Lang == "tr"
                                ? new (string Val, string Lbl)[] {
                                    ("", "Tümü"), ("none", "Genel"), ("web", "Web"),
                                    ("social", "Sosyal"), ("print", "Baskı"), ("news", "Haber") }
                                : new (string Val, string Lbl)[] {
                                    ("", "All"), ("none", "General"), ("web", "Web"),
                                    ("social", "Social"), ("print", "Print"), ("news", "News") };
                        }
                        @foreach (var o in profOpts)
                        {
                            if (Model.FilterProfile == o.Val || (string.IsNullOrEmpty(Model.FilterProfile) && o.Val == ""))
                            {
                                <option value="@o.Val" selected>@o.Lbl</option>
                            }
                            else
                            {
                                <option value="@o.Val">@o.Lbl</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.type"]</label>
                    <select name="fileType" class="form-select form-select-sm rounded-3">
                        @{
                            var typeOpts = new[] { "", "jpg", "png", "webp", "tiff", "bmp" };
                        }
                        @foreach (var ft in typeOpts)
                        {
                            if (Model.FilterFileType == ft || (string.IsNullOrEmpty(Model.FilterFileType) && ft == ""))
                            {
                                <option value="@ft" selected>@(ft == "" ? T["hist.all"] : ft.ToUpper())</option>
                            }
                            else
                            {
                                <option value="@ft">@ft.ToUpper()</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 col-6">
                    <label class="form-label small text-muted mb-1">@T["hist.name"]</label>
                    <input type="text" name="q" value="@Model.FilterQuery" maxlength="100"
                           placeholder="@(T.Lang == "tr" ? "Ara…" : "Search…")" class="form-control form-control-sm rounded-3" />
                </div>
                <div class="col-md-1 col-12 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm rounded-3 flex-fill">@T["hist.filter"]</button>
                    @if (Model.HasActiveFilters)
                    {
                        <a asp-controller="Analysis" asp-action="History" class="btn btn-outline-secondary btn-sm rounded-3" title="@T["hist.clear"]">✕</a>
                    }
                </div>
            </div>
        </form>

        @if (Model.HasActiveFilters)
        {
            <p class="text-muted small mb-3">@Model.Items.Count @T["hist.found"]</p>
        }

        @if (Model.Items.Count > 0)
        {
            <div class="row g-4">
                @foreach (var item in Model.Items)
                {
                    var labelClass = item.Label switch {
                        var l when l.Contains("YAPAY")       => "ai",
                        var l when l.Contains("MANİPÜLE")    => "ai",
                        var l when l.Contains("GERÇEK")      => "quality",
                        _                                    => "both"
                    };

                    <div class="col-lg-4">
                        <div class="history-record-card">

                            <div class="record-top">
                                <span class="record-type @labelClass">@(string.IsNullOrEmpty(item.Label) ? "Analiz" : item.Label)</span>
                                <small>@(item.CreatedAt.Length >= 10 ? item.CreatedAt[..10] : item.CreatedAt)</small>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Thumbnail))
                            {
                                <div class="text-center my-2">
                                    <img src="@item.Thumbnail"
                                         alt="Analiz görseli"
                                         style="max-height:90px;border-radius:8px;object-fit:cover;" />
                                </div>
                            }

                            <h4 class="mt-2">@item.Name</h4>

                            @if (!string.IsNullOrEmpty(item.Verdict))
                            {
                                <p class="text-muted small" style="font-size:0.82rem;line-height:1.4">
                                    @(item.Verdict.Length > 100 ? item.Verdict[..100] + "…" : item.Verdict)
                                </p>
                            }

                            <div class="record-metrics">
                                @if (item.FakeProb.HasValue)
                                {
                                    <div>
                                        <span>@T["hist.ai"]</span>
                                        <strong>@item.FakeProb.Value.ToString("F1")%</strong>
                                    </div>
                                }
                                @if (item.Overall.HasValue)
                                {
                                    <div>
                                        <span>@T["hist.qual"]</span>
                                        <strong>@item.Overall.Value.ToString("F0")</strong>
                                    </div>
                                }
                            </div>

                            <div class="d-flex gap-2 mt-4 flex-wrap">
                                <a asp-controller="Analysis"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary rounded-4 flex-fill">
                                    @T["hist.detail"]
                                </a>
                                <a asp-controller="Analysis"
                                   asp-action="Report"
                                   asp-route-id="@item.Id"
                                   target="_blank"
                                   class="btn btn-outline-primary rounded-4"
                                   title="@T["hist.report"]">
                                    @T["hist.report"]
                                </a>
                                <form asp-controller="Analysis" asp-action="Delete" asp-route-id="@item.Id"
                                      method="post" onsubmit="return confirm('@(T.Lang == "tr" ? "Bu kayıt kalıcı olarak silinecek. Emin misiniz?" : "This record will be permanently deleted. Are you sure?")');">
                                    <button type="submit" class="btn btn-outline-danger rounded-4" title="@T["hist.delete"]">@T["hist.delete"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (string.IsNullOrEmpty(Model.Error) && Model.HasActiveFilters)
        {
            <div class="empty-history-box mt-5">
                <h5>@T["hist.nofilt"]</h5>
                <p>@T["hist.nofilt2"]</p>
                <a asp-controller="Analysis" asp-action="History" class="btn btn-outline-primary rounded-4 mt-3">
                    @T["hist.filtclear"]
                </a>
            </div>
        }
        else if (string.IsNullOrEmpty(Model.Error))
        {
            <div class="empty-history-box mt-5">
                <h5>@T["hist.empty"]</h5>
                <p>@T["hist.empty2"]</p>
                <a asp-controller="Analysis" asp-action="Upload"
                   class="btn btn-primary rounded-4 mt-3">
                    @T["hist.empty3"]
                </a>
            </div>
        }

    </div>
</section>
