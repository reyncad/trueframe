@model TrueFrameUI.Models.AnalysisViewModel
@{
    ViewData["Title"] = "Rapor Detayı";
}

<section class="details-page">
    <div class="container py-5">

        <div class="details-header mb-5">
            <div>
                <span class="section-label">Rapor Detayı</span>
                <h1 class="section-title">Analiz raporu detayı</h1>
                @if (!string.IsNullOrEmpty(Model.OriginalName))
                {
                    <p class="section-desc text-start ms-0">
                        <strong>@Model.OriginalName</strong>
                        @if (!string.IsNullOrEmpty(Model.CreatedAt))
                        {
                            <span class="text-muted ms-2">— @(Model.CreatedAt.Length >= 10 ? Model.CreatedAt[..10] : Model.CreatedAt)</span>
                        }
                    </p>
                }
            </div>
            <a asp-controller="Analysis" asp-action="History" class="btn btn-outline-primary rounded-4">
                Kayıtlara Dön
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger rounded-4">@Model.ErrorMessage</div>
        }
        else
        {
            <div class="row g-4">

                @* Sol: Görsel + Bilgi *@
                <div class="col-lg-5">
                    <div class="detail-image-card">
                        <div class="result-card-title">
                            <strong>Analiz Edilen Görsel</strong>
                            <span>@(Model.CreatedAt?.Length >= 10 ? Model.CreatedAt[..10] : "")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            @* Thumbnail (base64) veya path *@
                            @if (Model.ImagePath.StartsWith("data:"))
                            {
                                <img src="@Model.ImagePath" class="result-image mt-3"
                                     style="border-radius:12px;" />
                            }
                            else
                            {
                                <div class="detail-image-placeholder mt-3">
                                    Görsel önizleme mevcut değil
                                </div>
                            }
                        }

                        <div class="detail-meta mt-4">
                            @if (!string.IsNullOrEmpty(Model.CreatedAt))
                            {
                                <div><span>Analiz Tarihi</span><strong>@Model.CreatedAt</strong></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Label))
                            {
                                <div><span>Tespit Sonucu</span><strong>@Model.Label</strong></div>
                            }
                            @if (Model.ImgWidth > 0)
                            {
                                <div><span>Çözünürlük</span><strong>@Model.ImgWidth x @Model.ImgHeight px</strong></div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ImgFormat))
                            {
                                <div><span>Format</span><strong>@Model.ImgFormat</strong></div>
                            }
                        </div>
                    </div>
                </div>

                @* Sağ: Sonuçlar *@
                <div class="col-lg-7">
                    <div class="detail-report-card">

                        <div class="status-success-box mb-4">
                            <div>
                                <strong>@Model.StatusMessage</strong>
                            </div>
                            <span>Saved</span>
                        </div>

                        @* Real/Fake *@
                        @if (Model.AiProbability > 0 || Model.RealProbability > 0)
                        {
                            <div class="result-section mb-4">
                                <div class="result-section-header">
                                    <div>
                                        <h4>Real / Fake Sonucu</h4>
                                        <p>@Model.Label</p>
                                    </div>
                                    <div class="score-badge">@Model.ConfidenceScore.ToString("F1")%</div>
                                </div>

                                @if (Model.IsManipulated)
                                {
                                    <div class="alert alert-warning rounded-4 mt-2 d-flex align-items-center gap-2">
                                        <strong>⚠ Manipülasyon Tespit Edildi</strong>
                                        <span class="ms-auto badge bg-warning text-dark">
                                            Skor: @Model.ManipScore.ToString("F1")%
                                        </span>
                                    </div>
                                }

                                <div class="row g-3 mt-2">
                                    <div class="col-md-6">
                                        <div class="metric-card danger-metric">
                                            <p>AI Olasılığı</p>
                                            <h2>@Model.AiProbability.ToString("F1")%</h2>
                                            <div class="progress">
                                                <div class="progress-bar"
                                                     style="width:@Model.AiProbability.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="metric-card success-metric">
                                            <p>Gerçek Olasılığı</p>
                                            <h2>@Model.RealProbability.ToString("F1")%</h2>
                                            <div class="progress">
                                                <div class="progress-bar bg-success"
                                                     style="width:@Model.RealProbability.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Kalite *@
                        @if (Model.QualityScore > 0)
                        {
                            <div class="result-section mb-4">
                                <div class="result-section-header">
                                    <div>
                                        <h4>Kalite Değerlendirmesi</h4>
                                        @if (!string.IsNullOrEmpty(Model.ProfileLabel))
                                        {
                                            <p class="text-muted small">Profil: @Model.ProfileLabel — @Model.ProfilePass/@Model.ProfileTotal geçildi</p>
                                        }
                                    </div>
                                    <div class="quality-score-circle">@Model.QualityScore.ToString("F0")</div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Verdict))
                                {
                                    <div class="alert alert-light border rounded-4 mt-3 mb-3" style="font-size:0.9rem">
                                        @Model.Verdict
                                    </div>
                                }

                                @* FIX: Details'de radar chart eksikti — Result.cshtml ile tutarlı hale getirildi *@
                                <div class="chart-card mt-3 mb-3">
                                    <h6 class="text-muted mb-2">6 Boyutlu Kalite Profili</h6>
                                    <div class="chart-wrapper" style="max-width:280px;margin:auto">
                                        <canvas id="detailRadarChart"></canvas>
                                    </div>
                                </div>

                                <div class="quality-metrics-grid mt-3">
                                    <div class="quality-metric"><span>Keskinlik</span><strong>@Model.Sharpness.ToString("F1")</strong></div>
                                    <div class="quality-metric"><span>Gürültü</span><strong>@Model.Noise.ToString("F1")</strong></div>
                                    <div class="quality-metric"><span>Pozlama</span><strong>@Model.Exposure.ToString("F1")</strong></div>
                                    <div class="quality-metric"><span>Renk</span><strong>@Model.Color.ToString("F1")</strong></div>
                                    <div class="quality-metric"><span>Estetik</span><strong>@Model.Aesthetics.ToString("F1")</strong></div>
                                    <div class="quality-metric"><span>Teknik</span><strong>@Model.Technical.ToString("F1")</strong></div>
                                </div>
                            </div>
                        }

                        @* FIX: Profil kontrol listesi Details'de eksikti *@
                        @if (Model.Checks.Count > 0)
                        {
                            <h5 class="mt-4 mb-2">@(string.IsNullOrEmpty(Model.ProfileLabel) ? "Profil" : Model.ProfileLabel) Kontrol Listesi</h5>
                            <div class="table-responsive">
                                <table class="table table-sm rounded-4 overflow-hidden">
                                    <thead class="table-light">
                                        <tr><th></th><th>Kontrol</th><th>Değer</th><th>Gerekli</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.Checks)
                                        {
                                            var passClass = c.Passed == true  ? "text-success"
                                                          : c.Passed == false ? "text-danger"
                                                          : "text-muted";
                                            var passIcon  = c.Passed == true  ? "✓"
                                                          : c.Passed == false ? "✗"
                                                          : "—";
                                            <tr>
                                                <td class="@passClass">@passIcon</td>
                                                <td>@c.Name</td>
                                                <td class="@passClass">@c.Value</td>
                                                <td class="text-muted">@c.Needed</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* IQA Metrikleri *@
                        @if (Model.IqaMetrics.Count > 0)
                        {
                            <h5 class="mt-4 mb-2">IQA Metrik Skorları</h5>
                            <div class="table-responsive">
                                <table class="table table-sm rounded-4 overflow-hidden">
                                    <thead class="table-light">
                                        <tr><th>Metrik</th><th>Skor</th><th>Kalite</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in Model.IqaMetrics)
                                        {
                                            string qualityClass = "text-muted", qualityLabel = "—";
                                            if (!string.IsNullOrEmpty(m.Error))
                                            { qualityLabel = "Hata"; qualityClass = "text-danger"; }
                                            else if (m.Score.HasValue)
                                            {
                                                bool good = m.Direction == "higher"
                                                    ? m.Score.Value >= m.GoodMin
                                                    : m.Score.Value <= m.GoodMax;
                                                qualityLabel = good ? "İyi" : "Zayıf";
                                                qualityClass = good ? "text-success" : "text-warning";
                                            }
                                            <tr>
                                                <td><strong>@m.Label</strong></td>
                                                <td>@(m.Score.HasValue ? m.Score.Value.ToString("F4") : "—")</td>
                                                <td class="@qualityClass">@qualityLabel</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>

            </div>
        }

    </div>
</section>

@* FIX: Details sayfasında PDF butonu eksikti *@
<div class="text-center mt-3 mb-5">
    <button id="pdfBtn" onclick="exportDetailPdf()" class="btn btn-outline-secondary rounded-4 px-4">
        PDF Olarak İndir
    </button>
</div>

@if (Model.QualityScore > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rctx = document.getElementById('detailRadarChart');
            if (rctx) {
                new Chart(rctx, {
                    type: 'radar',
                    data: {
                        labels: ['Keskinlik', 'Gürültü', 'Pozlama', 'Renk', 'Estetik', 'Teknik'],
                        datasets: [{
                            label: 'Kalite Profili',
                            data: [
                                @Model.Sharpness.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                                @Model.Noise.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                                @Model.Exposure.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                                @Model.Color.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                                @Model.Aesthetics.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                                @Model.Technical.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                            ],
                            backgroundColor: 'rgba(37,99,235,0.15)',
                            borderColor: '#2563eb',
                            pointBackgroundColor: '#2563eb'
                        }]
                    },
                    options: {
                        scales: { r: { min: 0, max: 100, ticks: { display: false } } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}

@* FIX: exportDetailPdf() fonksiyonu eksikti — PDF butonu çalışmıyordu *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
async function exportDetailPdf() {
    const btn = document.getElementById('pdfBtn');
    btn.disabled = true;
    btn.textContent = 'Hazırlanıyor...';

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const W = 210, M = 16;
    let y = 20;

    // ── Header
    doc.setFillColor(37, 99, 235);
    doc.rect(0, 0, W, 14, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(11); doc.setFont('helvetica', 'bold');
    doc.text('TrueFrame — Analiz Raporu', M, 9.5);
    doc.setFontSize(8); doc.setFont('helvetica', 'normal'); doc.setTextColor(200, 220, 255);
    const now = new Date().toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' });
    doc.text(now, W - M, 9.5, { align: 'right' });
    y = 22;

    function sectionBox(color, h) {
        doc.setFillColor(...color);
        doc.roundedRect(M, y, W - M * 2, h, 3, 3, 'F');
    }
    function heading(txt) {
        doc.setFontSize(11); doc.setFont('helvetica', 'bold'); doc.setTextColor(15, 23, 42);
        doc.text(txt, M + 4, y + 7); y += 10;
    }
    function line(txt) {
        doc.setFontSize(9); doc.setFont('helvetica', 'normal'); doc.setTextColor(71, 85, 105);
        doc.text(txt, M + 4, y); y += 6;
    }

    @* Meta *@
    @if (!string.IsNullOrEmpty(Model.OriginalName))
    {
        <text>
        doc.setFontSize(9); doc.setFont('helvetica', 'italic'); doc.setTextColor(100, 116, 139);
        doc.text('Dosya: @Html.Raw(Model.OriginalName?.Replace("'", "\\'"))   |   Tarih: @Html.Raw((Model.CreatedAt ?? "").Replace("'", "\\'"))', M, y);
        y += 8;
        </text>
    }

    @* Real / Fake *@
    @if (Model.AiProbability > 0 || Model.RealProbability > 0)
    {
        <text>
        sectionBox([239, 246, 255], 34);
        heading('Real / Fake Analizi');
        line('Tespit: @Model.Label   |   Güven: @Model.ConfidenceScore.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%');
        line('AI Olasılığı: @Model.AiProbability.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%   |   Gerçek Olasılığı: @Model.RealProbability.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%');
        @if (Model.IsManipulated)
        {
            <text>line('⚠ Manipülasyon Tespit Edildi — Skor: @Model.ManipScore.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%');</text>
        }
        y += 6;
        </text>
    }

    @* Kalite *@
    @if (Model.QualityScore > 0)
    {
        <text>
        if (y > 220) { doc.addPage(); y = 20; }
        sectionBox([240, 253, 244], 52);
        heading('Görsel Kalite Analizi');
        line('Genel Skor: @Model.QualityScore.ToString("F0", System.Globalization.CultureInfo.InvariantCulture) / 100');
        @if (!string.IsNullOrEmpty(Model.ProfileLabel))
        {
            <text>line('Profil: @Model.ProfileLabel — @Model.ProfilePass/@Model.ProfileTotal kontrol geçildi');</text>
        }
        const dims6 = [
            'Keskinlik: @Model.Sharpness.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)',
            'Gürültü: @Model.Noise.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)',
            'Pozlama: @Model.Exposure.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)',
            'Renk: @Model.Color.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)',
            'Estetik: @Model.Aesthetics.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)',
            'Teknik: @Model.Technical.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)'
        ];
        doc.setFontSize(9); doc.setFont('helvetica', 'normal'); doc.setTextColor(71, 85, 105);
        dims6.forEach((d, i) => { doc.text(d, i > 2 ? M + 4 + 90 : M + 4, y + (i % 3) * 6); });
        y += 22;
        </text>
    }

    @* Verdict *@
    @if (!string.IsNullOrEmpty(Model.Verdict))
    {
        <text>
        if (y > 250) { doc.addPage(); y = 20; }
        doc.setFontSize(8); doc.setFont('helvetica', 'italic'); doc.setTextColor(100, 116, 139);
        const vlines = doc.splitTextToSize('@Html.Raw(Model.Verdict?.Replace("'", "\\'").Replace("\n", " ").Replace("\"", "\\\""))', W - M * 2 - 4);
        doc.text(vlines, M + 2, y); y += vlines.length * 5 + 4;
        </text>
    }

    @* IQA Metrikleri *@
    @if (Model.IqaMetrics.Count > 0)
    {
        <text>
        if (y > 220) { doc.addPage(); y = 20; }
        doc.setFontSize(10); doc.setFont('helvetica', 'bold'); doc.setTextColor(15, 23, 42);
        doc.text('IQA Metrik Skorları', M, y); y += 6;
        doc.setFillColor(226, 232, 240); doc.rect(M, y, W - M * 2, 6, 'F');
        doc.setFontSize(8); doc.setFont('helvetica', 'bold'); doc.setTextColor(71, 85, 105);
        doc.text('Metrik', M + 2, y + 4);
        doc.text('Skor', M + 80, y + 4);
        doc.text('Kalite', M + 120, y + 4);
        y += 7;
        </text>
        @foreach (var m in Model.IqaMetrics)
        {
            bool good  = m.Direction == "higher" ? (m.Score ?? 0) >= m.GoodMin : (m.Score ?? 0) <= m.GoodMax;
            string ql  = string.IsNullOrEmpty(m.Error) ? (good ? "İyi" : "Zayıf") : "Hata";
            int[] qRgb = string.IsNullOrEmpty(m.Error) ? (good ? new[] { 22, 163, 74 } : new[] { 202, 138, 4 }) : new[] { 220, 38, 38 };
            string sc  = m.Score.HasValue ? m.Score.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "-";
            <text>
            if (y > 270) { doc.addPage(); y = 20; }
            doc.setFont('helvetica', 'normal'); doc.setTextColor(15, 23, 42);
            doc.text('@m.Label', M + 2, y + 4);
            doc.text('@sc', M + 80, y + 4);
            doc.setTextColor(@(qRgb[0]), @(qRgb[1]), @(qRgb[2]));
            doc.text('@ql', M + 120, y + 4);
            y += 6;
            </text>
        }
    }

    // ── Footer
    const pageCount = doc.internal.getNumberOfPages();
    for (let p = 1; p <= pageCount; p++) {
        doc.setPage(p);
        doc.setFillColor(37, 99, 235); doc.rect(0, 290, W, 7, 'F');
        doc.setTextColor(255, 255, 255); doc.setFontSize(7); doc.setFont('helvetica', 'normal');
        doc.text('TrueFrame AI Görsel Doğrulama Platformu', M, 295);
        doc.text('Sayfa ' + p + ' / ' + pageCount, W - M, 295, { align: 'right' });
    }

    doc.save('trueframe-rapor-@(DateTime.Now.ToString("yyyyMMdd")).pdf');
    btn.disabled = false;
    btn.textContent = 'PDF Olarak İndir';
}
</script>

@if (Model.AiProbability > 0 || Model.RealProbability > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.createElement('canvas');
            el.id = 'detailChart';
            el.style.maxWidth = '220px';
            el.style.margin = 'auto';
            const wrapper = document.querySelector('.result-section .row.g-3');
            if (wrapper) {
                const card = document.createElement('div');
                card.className = 'chart-card mt-4';
                card.innerHTML = '<h5>AI / Gerçek Dağılım</h5>';
                card.appendChild(el);
                wrapper.parentElement.appendChild(card);
                new Chart(el, {
                    type: 'doughnut',
                    data: {
                        labels: ['AI Olasılığı', 'Gerçek Olasılığı'],
                        datasets: [{
                            data: [@Model.AiProbability.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                                   @Model.RealProbability.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)],
                            backgroundColor: ['#2563eb', '#16a34a'],
                            borderWidth: 0
                        }]
                    },
                    options: { cutout: '68%', plugins: { legend: { position: 'bottom' } } }
                });
            }
        });
    </script>
}
