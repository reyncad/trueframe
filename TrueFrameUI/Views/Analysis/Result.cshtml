@model TrueFrameUI.Models.AnalysisViewModel

@{
    ViewData["Title"] = "Analiz Sonucu";
}

<section class="result-page">

    <div class="container py-5">

        <div class="result-header mb-5">

            <div>
                <span class="section-label">Analiz Sonucu</span>
                <h1 class="section-title">Analiz sonucu hazır</h1>
                <p class="section-desc text-start ms-0">
                    Yüklenen görsel için seçilen analiz sonuçları aşağıda özetlenmiştir.
                </p>
            </div>

            <a asp-controller="Analysis" asp-action="Upload" class="btn btn-outline-primary rounded-4">
                Yeni Analiz Yap
            </a>

        </div>

        <div class="row g-4">

            <div class="col-lg-5">

                <div class="result-image-card">

                    <div class="result-card-title">
                        <strong>Yüklenen Görsel</strong>
                        <span>Preview</span>
                    </div>

                    <div class="heatmap-image-wrapper">

                        <img src="@Model.ImagePath" class="result-image" />

                        @if (Model.RealFakeSelected)
                        {
                            <div class="heatmap-zone zone-one">
                                <span>texture</span>
                            </div>

                            <div class="heatmap-zone zone-two">
                                <span>lighting</span>
                            </div>

                            <div class="heatmap-zone zone-three">
                                <span>edge</span>
                            </div>
                        }

                    </div>
                </div>

            </div>

            <div class="col-lg-7">

                <div class="result-summary-card">

                    <div class="status-success-box mb-4">
                        <div>
                            <strong>@Model.StatusMessage</strong>
                            <p>Sonuçlar demo veriler üzerinden oluşturulmuştur.</p>
                        </div>

                        <span>Completed</span>
                    </div>

                    @if (Model.RealFakeSelected)
                    {
                        <div class="result-section mb-4">

                            <div class="result-section-header">
                                <div>
                                    <h4>Real / Fake Analizi</h4>
                                    <p>Görselin yapay zekâ tarafından üretilmiş olma olasılığı</p>
                                </div>

                                <div class="score-badge">
                                    @Model.ConfidenceScore%
                                </div>
                            </div>

                            <div class="row g-3 mt-2">

                                <div class="col-md-6">
                                    <div class="metric-card danger-metric">
                                        <p>AI Probability</p>
                                        <h2>@Model.AiProbability%</h2>

                                        <div class="progress">
                                            <div class="progress-bar" style="width:@Model.AiProbability%"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="chart-card mt-4">

                                    <h5>AI / Real Dağılım Grafiği</h5>

                                    <div class="chart-wrapper">
                                        <canvas id="resultChart"></canvas>
                                    </div>

                                </div>

                                <div class="col-md-6">
                                    <div class="metric-card success-metric">
                                        <p>Real Probability</p>
                                        <h2>@Model.RealProbability%</h2>

                                        <div class="progress">
                                            <div class="progress-bar bg-success" style="width:@Model.RealProbability%"></div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="explanation-card mt-4">
                                <h5>Açıklama</h5>
                                <p>@Model.Explanation</p>
                            </div>

                        </div>
                    }

                    @if (Model.QualitySelected)
                    {
                        <div class="result-section">

                            <div class="result-section-header">
                                <div>
                                    <h4>Görsel Kalite Analizi</h4>
                                    <p>Netlik, kontrast, gürültü ve kullanılabilirlik değerlendirmesi</p>
                                </div>

                                <div class="quality-score-circle">
                                    @Model.QualityScore
                                </div>
                            </div>

                            <div class="quality-metrics-grid mt-4">

                                <div class="quality-metric">
                                    <span>Netlik</span>
                                    <strong>@Model.Sharpness</strong>
                                </div>

                                <div class="quality-metric">
                                    <span>Kontrast</span>
                                    <strong>@Model.Contrast</strong>
                                </div>

                                <div class="quality-metric">
                                    <span>Gürültü Seviyesi</span>
                                    <strong>@Model.NoiseLevel</strong>
                                </div>

                                <div class="quality-metric">
                                    <span>Kullanılabilirlik</span>
                                    <strong>@Model.Usability</strong>
                                </div>

                            </div>

                            <div class="default-info mt-4">
                                Kalite skoru; netlik, kontrast, gürültü seviyesi ve genel kullanılabilirlik ölçütlerine göre değerlendirilir.
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('resultChart');

    if (ctx) {
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['AI Probability', 'Real Probability'],
                datasets: [{
                    data: [@Model.AiProbability, @Model.RealProbability],
                    backgroundColor: ['#2563eb', '#16a34a'],
                    borderWidth: 0
                }]
            },
            options: {
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    }
</script>