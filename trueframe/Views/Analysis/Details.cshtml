@{
    ViewData["Title"] = "Rapor Detayı";
}

<section class="details-page">

    <div class="container py-5">

        <div class="details-header mb-5">

            <div>
                <span class="section-label">Rapor Detayı</span>

                <h1 class="section-title">
                    Analiz raporu detayı
                </h1>

                <p class="section-desc text-start ms-0">
                    Bu ekran, kayıtlı kullanıcıların geçmiş analiz sonuçlarını detaylı şekilde inceleyebilmesi için tasarlanmıştır.
                </p>
            </div>

            <a asp-controller="Analysis" asp-action="History" class="btn btn-outline-primary rounded-4">
                Kayıtlara Dön
            </a>

        </div>

        <div class="row g-4">

            <div class="col-lg-5">

                <div class="detail-image-card">

                    <div class="result-card-title">
                        <strong>Analiz Edilen Görsel</strong>
                        <span>Demo Preview</span>
                    </div>

                    <div class="detail-image-placeholder">
                        Image Preview
                    </div>

                    <div class="detail-meta mt-4">
                        <div>
                            <span>Analiz Tarihi</span>
                            <strong>13 May 2026</strong>
                        </div>

                        <div>
                            <span>Analiz Türü</span>
                            <strong>Real/Fake + Quality</strong>
                        </div>

                        <div>
                            <span>Model Sürümü</span>
                            <strong>Demo-v1.0</strong>
                        </div>

                        <div>
                            <span>Karar Eşiği</span>
                            <strong>0.50</strong>
                        </div>
                    </div>

                </div>

            </div>

            <div class="col-lg-7">

                <div class="detail-report-card">

                    <div class="status-success-box mb-4">
                        <div>
                            <strong>Rapor başarıyla oluşturuldu.</strong>
                            <p>Bu bilgiler demo arayüz amacıyla sabit veri olarak gösterilmektedir.</p>
                        </div>

                        <span>Saved</span>
                    </div>

                    <div class="result-section mb-4">

                        <div class="result-section-header">
                            <div>
                                <h4>Real / Fake Sonucu</h4>
                                <p>Görselin yapay zekâ üretimi olma ihtimali</p>
                            </div>

                            <div class="score-badge">
                                91%
                            </div>
                        </div>

                        <div class="row g-3 mt-2">

                            <div class="col-md-6">
                                <div class="metric-card danger-metric">
                                    <p>AI Probability</p>
                                    <h2>72%</h2>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:72%"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="metric-card success-metric">
                                    <p>Real Probability</p>
                                    <h2>28%</h2>
                                    <div class="progress">
                                        <div class="progress-bar bg-success" style="width:28%"></div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="result-section mb-4">

                        <div class="result-section-header">
                            <div>
                                <h4>Kalite Değerlendirmesi</h4>
                                <p>Görselin teknik kalite metrikleri</p>
                            </div>

                            <div class="quality-score-circle">
                                84
                            </div>
                        </div>

                        <div class="quality-metrics-grid mt-4">

                            <div class="quality-metric">
                                <span>Netlik</span>
                                <strong>82</strong>
                            </div>

                            <div class="quality-metric">
                                <span>Kontrast</span>
                                <strong>78</strong>
                            </div>

                            <div class="quality-metric">
                                <span>Gürültü Seviyesi</span>
                                <strong>18</strong>
                            </div>

                            <div class="quality-metric">
                                <span>Kullanılabilirlik</span>
                                <strong>88</strong>
                            </div>

                        </div>

                    </div>

                    <div class="explanation-card">
                        <h5>Açıklama Metni</h5>

                        <p>
                            Görselde ışık dağılımı, doku geçişleri ve bazı detaylarda yapay üretime benzer izler tespit edilmiştir.
                            Bu nedenle sistem görselin yapay zekâ tarafından üretilmiş olma ihtimalini yüksek değerlendirmiştir.
                            Kalite analizinde ise görselin netlik ve kullanılabilirlik açısından yeterli seviyede olduğu görülmektedir.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>