@model TrueFrameUI.Models.AnalysisViewModel
@{
    ViewData["Title"] = "Analiz Sonucu";
}

<section class="result-page">
    <div class="container py-5">

        <div class="result-header mb-5">
            <div>
                <span class="section-label">Analiz Sonucu</span>
                <h1 class="section-title">Analiz sonucu hazır</h1>
                <p class="section-desc text-start ms-0">
                    Yüklenen görsel için seçilen analiz sonuçları aşağıda özetlenmiştir.
                </p>
            </div>
            <a asp-controller="Analysis" asp-action="Upload" class="btn btn-outline-primary rounded-4">
                Yeni Analiz Yap
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <div class="row g-4">

            
@* Sol: Görsel  *@
            <div class="col-lg-5">
                <div class="result-image-card">
                    <div class="result-card-title">
                        <strong>Yüklenen Görsel</strong>
                        <span>Preview</span>
                    </div>
                    <div class="heatmap-image-wrapper">
                        <img src="@Model.ImagePath" class="result-image" />
                        @if (Model.QualitySelected)
                        {
                            <div class="heatmap-zone zone-one"><span>texture</span></div>
                            <div class="heatmap-zone zone-two"><span>lighting</span></div>
                            <div class="heatmap-zone zone-three"><span>edge</span></div>
                        }
                    </div>
                </div>

                @if (Model.QualitySelected && Model.ImgWidth > 0)
                {
                    <div class="result-image-card mt-4">
                        <div class="result-card-title"><strong>Görsel Bilgisi</strong></div>
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="text-muted">Çözünürlük</td><td>@Model.ImgWidth x @Model.ImgHeight px</td></tr>
                                <tr><td class="text-muted">Megapiksel</td><td>@Model.Megapixels.ToString("F2") MP</td></tr>
                                @if (!string.IsNullOrEmpty(Model.ImgFormat))
                                {
                                    <tr><td class="text-muted">Format</td><td>@Model.ImgFormat</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.ColorMode))
                                {
                                    <tr><td class="text-muted">Renk Modu</td><td>@Model.ColorMode</td></tr>
                                }
                                @if (Model.Dpi.HasValue)
                                {
                                    <tr><td class="text-muted">DPI</td><td>@Model.Dpi.Value.ToString("F0")</td></tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.ExifDatetime))
                                {
                                    <tr><td class="text-muted">Çekim Tarihi</td><td>@Model.ExifDatetime</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            
@* Sağ: Analiz Sonuçları  *@
            <div class="col-lg-7">
                <div class="result-summary-card">

                    <div class="status-success-box mb-4">
                        <div>
                            <strong>@Model.StatusMessage</strong>
                        </div>
                        <span>Completed</span>
                    </div>

                    
@* Real / Fake Analizi  *@
                    @if (Model.RealFakeSelected)
                    {
                        <div class="result-section mb-4">
                            <div class="result-section-header">
                                <div>
                                    <h4>Real / Fake Analizi</h4>
                                    <p>@Model.Label</p>
                                </div>
                                <div class="score-badge">
                                    @Model.ConfidenceScore.ToString("F1")%
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <div class="metric-card danger-metric">
                                        <p>AI Olasılığı</p>
                                        <h2>@Model.AiProbability.ToString("F1")%</h2>
                                        <div class="progress">
                                            <div class="progress-bar" style="width:@Model.AiProbability.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="metric-card success-metric">
                                        <p>Gerçek Olasılığı</p>
                                        <h2>@Model.RealProbability.ToString("F1")%</h2>
                                        <div class="progress">
                                            <div class="progress-bar bg-success" style="width:@Model.RealProbability.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="chart-card mt-4">
                                <h5>AI / Gerçek Dağılım Grafiği</h5>
                                <div class="chart-wrapper">
                                    <canvas id="resultChart"></canvas>
                                </div>
                            </div>
                        </div>
                    }

                    
@* Kalite Analizi  *@
                    @if (Model.QualitySelected)
                    {
                        <div class="result-section">

                            
@* Skor + Verdict  *@
                            <div class="result-section-header">
                                <div>
                                    <h4>Görsel Kalite Analizi</h4>
                                    @if (!string.IsNullOrEmpty(Model.ProfileLabel))
                                    {
                                        <p class="text-muted small">Profil: @Model.ProfileLabel — @Model.ProfilePass/@Model.ProfileTotal kontrol geçildi</p>
                                    }
                                </div>
                                <div class="quality-score-circle">@Model.QualityScore.ToString("F0")</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Verdict))
                            {
                                <div class="alert alert-light border rounded-4 mt-3 mb-3" style="font-size:0.9rem">
                                    @Model.Verdict
                                </div>
                            }

                            
@* 6 Boyutlu Radar  *@
                            <div class="chart-card mt-3 mb-4">
                                <h5>6 Boyutlu Kalite Profili</h5>
                                <div class="chart-wrapper" style="max-width:300px;margin:auto">
                                    <canvas id="radarChart"></canvas>
                                </div>
                            </div>

                            
@* 6D Grid  *@
                            <div class="quality-metrics-grid mt-2">
                                <div class="quality-metric"><span>Keskinlik</span><strong>@Model.Sharpness.ToString("F1")</strong></div>
                                <div class="quality-metric"><span>Gürültü</span><strong>@Model.Noise.ToString("F1")</strong></div>
                                <div class="quality-metric"><span>Pozlama</span><strong>@Model.Exposure.ToString("F1")</strong></div>
                                <div class="quality-metric"><span>Renk</span><strong>@Model.Color.ToString("F1")</strong></div>
                                <div class="quality-metric"><span>Estetik</span><strong>@Model.Aesthetics.ToString("F1")</strong></div>
                                <div class="quality-metric"><span>Teknik</span><strong>@Model.Technical.ToString("F1")</strong></div>
                            </div>

                            
@* Pozlama  *@
                            @if (!string.IsNullOrEmpty(Model.ExposureLabel))
                            {
                                <h5 class="mt-4 mb-2">Pozlama Analizi</h5>
                                <div class="quality-metrics-grid">
                                    <div class="quality-metric"><span>Pozlama</span><strong>@Model.ExposureLabel</strong></div>
                                    <div class="quality-metric"><span>Highlight Kırp.</span><strong>@Model.HighlightClip.ToString("F1")%</strong></div>
                                    <div class="quality-metric"><span>Shadow Kırp.</span><strong>@Model.ShadowClip.ToString("F1")%</strong></div>
                                    <div class="quality-metric"><span>Dinamik Aralık</span><strong>@Model.DynamicRange.ToString("F1")/100</strong></div>
                                    <div class="quality-metric"><span>Ort. Parlaklık</span><strong>@Model.AvgBrightness.ToString("F0")/255</strong></div>
                                </div>
                            }

                            
@* Renk & Gürültü  *@
                            @if (!string.IsNullOrEmpty(Model.ColorCast))
                            {
                                <h5 class="mt-4 mb-2">Renk & Gürültü</h5>
                                <div class="quality-metrics-grid">
                                    <div class="quality-metric"><span>Renk Cast</span><strong>@Model.ColorCast</strong></div>
                                    @if (Model.ColorTemperature.HasValue)
                                    {
                                        <div class="quality-metric"><span>Renk Sıcaklığı</span><strong>@Model.ColorTemperature.Value.ToString("F0")K</strong></div>
                                    }
                                    @if (Model.ColorTint.HasValue)
                                    {
                                        <div class="quality-metric"><span>Renk Tonu</span><strong>@Model.ColorTint.Value.ToString("F2")</strong></div>
                                    }
                                    @if (Model.Saturation.HasValue)
                                    {
                                        <div class="quality-metric"><span>Doygunluk</span><strong>@Model.Saturation.Value.ToString("F1")%</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ColorNoise))
                                    {
                                        <div class="quality-metric"><span>Renk Gürültüsü</span><strong>@Model.ColorNoise</strong></div>
                                    }
                                </div>
                            }

                            
@* Geometri & Blur  *@
                            @if (!string.IsNullOrEmpty(Model.BlurType))
                            {
                                <h5 class="mt-4 mb-2">Geometri & Blur Analizi</h5>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="metric-card text-center py-3">
                                            <small class="text-muted d-block">BLUR TİPİ</small>
                                            <strong class="text-primary">@Model.BlurLabel</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="metric-card text-center py-3">
                                            <small class="text-muted d-block">HORİZON EĞİKLİĞİ</small>
                                            @if (Model.TiltAngle.HasValue)
                                            {
                                                <strong class="@(Math.Abs(Model.TiltAngle.Value) > 3 ? "text-danger" : "text-success")">
                                                    @Model.TiltAngle.Value.ToString("+0.0;-0.0")°
                                                </strong>
                                                <small class="text-muted d-block">@Model.TiltLabel</small>
                                            }
                                            else
                                            {
                                                <strong>N/A</strong>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="metric-card text-center py-3">
                                            <small class="text-muted d-block">MOIRE PATTERN</small>
                                            <strong class="@(Model.MoireScore > 35 ? "text-danger" : "text-success")">@Model.MoireLabel</strong>
                                            <small class="text-muted d-block">Skor: @Model.MoireScore.ToString("F0")/100</small>
                                        </div>
                                    </div>
                                </div>
                            }

                            
@* IQA Metrik Tablosu  *@
                            @if (Model.IqaMetrics.Count > 0)
                            {
                                <h5 class="mt-4 mb-2">IQA Metrik Skorları</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm rounded-4 overflow-hidden">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Metrik</th>
                                                <th>Skor</th>
                                                <th>Kalite</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in Model.IqaMetrics)
                                            {
                                                string qualityClass = "text-muted";
                                                string qualityLabel = "—";
                                                if (!string.IsNullOrEmpty(m.Error))
                                                {
                                                    qualityLabel = "Hata";
                                                    qualityClass = "text-danger";
                                                }
                                                else if (m.Score.HasValue)
                                                {
                                                    bool good = m.Direction == "higher"
                                                        ? m.Score.Value >= m.GoodMin
                                                        : m.Score.Value <= m.GoodMax;
                                                    qualityLabel = good ? "İyi" : "Zayıf";
                                                    qualityClass = good ? "text-success" : "text-warning";
                                                }
                                                <tr>
                                                    <td><strong>@m.Label</strong></td>
                                                    <td>@(m.Score.HasValue ? m.Score.Value.ToString("F4") : "—")</td>
                                                    <td class="@qualityClass">@qualityLabel</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            
@* Profil Kontrol Listesi  *@
                            @if (Model.Checks.Count > 0)
                            {
                                <h5 class="mt-4 mb-2">@Model.ProfileLabel Kontrol Listesi</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm rounded-4 overflow-hidden">
                                        <thead class="table-light">
                                            <tr>
                                                <th></th>
                                                <th>Kontrol</th>
                                                <th>Değer</th>
                                                <th>Gerekli</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in Model.Checks)
                                            {
                                                <tr>
                                                    <td class="@(c.Passed ? "text-success" : "text-danger")">
                                                        @(c.Passed ? "✓" : "✗")
                                                    </td>
                                                    <td>@c.Name</td>
                                                    <td class="@(c.Passed ? "text-success" : "text-danger")">@c.Value</td>
                                                    <td class="text-muted">@c.Needed</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                        </div>
                    }

                </div>
            </div>
        </div>

        
@* PDF butonu  *@
        <div class="text-center mt-4">
            <button onclick="window.print()" class="btn btn-outline-secondary rounded-4 px-4">
                PDF Olarak İndir
            </button>
        </div>

    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@if (Model.RealFakeSelected)
{
    <script>
        const ctx = document.getElementById('resultChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['AI Olasılığı', 'Gerçek Olasılığı'],
                    datasets: [{
                        data: [@Model.AiProbability.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @Model.RealProbability.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)],
                        backgroundColor: ['#2563eb', '#16a34a'],
                        borderWidth: 0
                    }]
                },
                options: { cutout: '68%', plugins: { legend: { position: 'bottom' } } }
            });
        }
    </script>
}

@if (Model.QualitySelected)
{
    <script>
        const rctx = document.getElementById('radarChart');
        if (rctx) {
            new Chart(rctx, {
                type: 'radar',
                data: {
                    labels: ['Keskinlik', 'Gürültü', 'Pozlama', 'Renk', 'Estetik', 'Teknik'],
                    datasets: [{
                        label: 'Kalite Profili',
                        data: [
                            @Model.Sharpness.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                            @Model.Noise.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                            @Model.Exposure.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                            @Model.Color.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                            @Model.Aesthetics.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                            @Model.Technical.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                        ],
                        backgroundColor: 'rgba(37,99,235,0.15)',
                        borderColor: '#2563eb',
                        pointBackgroundColor: '#2563eb'
                    }]
                },
                options: {
                    scales: { r: { min: 0, max: 100, ticks: { display: false } } },
                    plugins: { legend: { display: false } }
                }
            });
        }
    </script>
}
