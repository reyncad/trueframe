# ─────────────────────────────────────────────────────────────
# TrueFrame — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# .env dosyasını asla git'e commit etmeyin!
# ─────────────────────────────────────────────────────────────

# Django gizli anahtarı — üretimde 50+ karakter rastgele string kullanın
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production

# Backend ile frontend arasındaki iç API anahtarı
# Üretmek için: python -c "import secrets; print(secrets.token_hex(24))"
TRUEFRAME_API_KEY=change-this-internal-api-key

# ASP.NET session şifreleme anahtarı
# Üretmek için: openssl rand -hex 32
SESSION_KEY=change-this-session-key-32-chars-min

# Production'da ek izin verilen hostlar (virgülle ayrılmış)
# Örnek: EXTRA_ALLOWED_HOSTS=trueframe.example.com,www.trueframe.example.com
EXTRA_ALLOWED_HOSTS=
